      "background": "$accent",
      "radius": 999,
      "padding": {
        "top": 1.6,
        "end": 9.6,
        "bottom": 1.6,
        "start": 9.6
      },
      "text": {
        "color": "$on-accent",
        "size": 12.8
      }
    },
    ".flag-casual": {
      "background": "$panel-2",
      "border": {
        "width": 1,
        "color": "#00000066",
        "style": "solid"
      },
      "radius": 999,
      "padding": {
        "top": 1.6,
        "end": 9.6,
        "bottom": 1.6,
        "start": 9.6
      },
      "text": {
        "color": "$ink-dim",
        "size": 12.8
      }
    },
    ".results-won": {
      "text": {
        "color": "$good",
        "size": 24,
        "weight": "800"
      }
    },
    ".results-lost": {
      "text": {
        "color": "$bad",
        "size": 24,
        "weight": "800"
      }
    },
    ".score-row": {
      "border": {
        "width": {
          "bottom": 1
        },
        "color": {
          "bottom": "#00000045"
        },
        "style": "solid"
      },
      "padding": {
        "top": 5.6,
        "end": 3.2,
        "bottom": 5.6,
        "start": 3.2
      }
    },
    ".score-total": {
      "padding": {
        "top": 5.6,
        "end": 3.2,
        "bottom": 5.6,
        "start": 3.2
      }
    },
    ".cell": {
      "text": {
        "color": "$ink"
      }
    },
    ".cell-num": {
      "text": {
        "color": "$ink",
        "weight": "700"
      }
    },
    ".cell-total": {
      "text": {
        "color": "$accent-2",
        "size": 18.4,
        "weight": "400"
      }
    },
    ".cell-total-num": {
      "text": {
        "color": "$accent-2",
        "size": 18.4,
        "weight": "700"
      }
    },
    ".results-dim": {
      "text": {
        "color": "$ink-dim",
        "size": 14.72
      }
    },
    ".achievement-chip": {
      "background": "$panel-2",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 999,
      "padding": {
        "top": 3.2,
        "end": 12.8,
        "bottom": 3.2,
        "start": 12.8
      },
      "text": {
        "color": "$ink",
        "size": 13.6
      }
    },
    ".mine": {
      "text": {
        "color": "$accent-2",
        "weight": "700"
      }
    },
    ".fieldset": {
      "border": {
        "width": 1,
        "color": "#00000066",
        "style": "solid"
      },
      "radius": "$radius",
      "padding": {
        "top": 12.8,
        "end": 16,
        "bottom": 12.8,
        "start": 16
      }
    },
    ".legend": {
      "text": {
        "color": "$accent-2"
      }
    },
    ".fine-print": {
      "text": {
        "color": "$ink-dim",
        "size": 12.8
      }
    },
    ".controls-row": {
      "padding": {
        "top": 3.2,
        "end": 0,
        "bottom": 3.2,
