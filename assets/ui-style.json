        "color": "#00000087",
        "style": "solid"
      },
      "radius": 6,
      "padding": {
        "top": 1.6,
        "end": 8,
        "bottom": 1.6,
        "start": 8
      },
      "text": {
        "color": "$ink"
      }
    },
    ".toast": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
      },
      "text": {
        "color": "$ink",
        "size": 15.2,
        "align": "center"
      }
    }
  },
  "animations": {},
  "tokens": {
    "accent": "#ff8c3a",
    "accent-2": "#ffc46a",
    "bad": "#ff5151",
    "bg": "#140b07",
    "focus": "#6ab8ff",
    "good": "#51c98a",
    "hover": "#3d2812",
    "ink": "#f4e8d8",
    "ink-dim": "#c9b49a",
    "on-accent": "#1a0d05",
    "panel": "#221409",
    "panel-2": "#2e1c0e",
    "radius": 12
  },
  "layouts": {},
  "dropped": []
}
