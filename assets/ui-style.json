        "color": "$accent-2",
        "size": 12
      }
    },
    ".setup-dt": {
      "text": {
        "color": "$ink-dim"
      }
    },
    ".setup-dd": {
      "text": {
        "color": "$ink",
        "weight": "600"
      }
    },
